+#[test]
+fn selective_and_reads_only_first_physical_bitmap_pages() {
+    let mut inner = MemoryStore::default();
+    mutable::initialize(&mut inner).unwrap();
+    for block in 0..256 {
+        insert(
+            &mut inner,
+            root(block, 291),
+            if block == 0 { "wide rare" } else { "wide" },
+        );
+    }
+    build(&mut inner).unwrap();
+    let mut liveness_pages = 0;
+    let mut posting_pages = 0;
+    for block in 0..inner.pages.len() {
+        let page = inner.read(block as u32).unwrap();
+        if page.kind() == PageKind::Grouped {
+            match page.group_identity().unwrap().1 {
+                GroupPageKind::Liveness => liveness_pages += 1,
+                GroupPageKind::Posting => posting_pages += 1,
+                _ => {}
+            }
+        }
+    }
+    assert_eq!((liveness_pages, posting_pages), (2, 2));
+    let mut store = Measured {
+        inner,
+        reads: Reads::default(),
+    };
+    assert_eq!(
+        raw(&mut store, "wide AND rare", 8 << 20).unwrap(),
+        vec![(root(0, 291), false)]
+    );
+    assert_eq!(store.reads.liveness, 1);
+    assert_eq!(store.reads.postings, 1);
+}
