+/// Reads the directory first, then only physical extents that contain wanted
+/// heap-page offsets. Unvisited offset payloads are never interpreted.
+pub(super) fn read_bitmap_view_selected<'a, S: PageStore>(
+    store: &mut S,
+    snapshot: GroupSnapshot,
+    entry: CatalogEntry,
+    output: &'a mut [u8],
+    wanted: PageMask,
+) -> Result<(Value, Bitmap<'a>)> {
+    let value = Value::read(entry)?;
+    if value.len == 0 {
+        return read_bitmap_view(store, snapshot, entry, output);
+    }
+    let output = output
+        .get_mut(..value.len as usize)
+        .ok_or(Error::Limit("group bitmap scratch"))?;
+    let kind = if entry.key[0] == 0 {
+        GroupPageKind::Liveness
+    } else {
+        GroupPageKind::Posting
+    };
+    let used = output.len().div_ceil(GROUP_DATA_BYTES);
+    read_bitmap_part(store, snapshot, entry.key, kind, value.blocks, output, 0)?;
+    // Header and at most 256 four-byte directory entries fit in one record
+    // page. Bitmap::open validates that directory without reading payloads.
+    let view = Bitmap::open(output)?;
+    let expected = if entry.key[0] == 0 {
+        BitmapKind::Liveness
+    } else {
+        BitmapKind::Posting
+    };
+    if view.key() != key(snapshot, entry.key[1] as u32, store.layout())?
+        || view.kind() != expected
+        || *view.pages() != value.pages
+    {
+        return Err(Error::InvalidState);
+    }
+    let mut needed = [false; 3];
+    for heap_page in Pages::new(wanted) {
+        if let Some((start, len)) = view.span(heap_page) {
+            let first = start / GROUP_DATA_BYTES;
+            let last = (start + len - 1) / GROUP_DATA_BYTES;
+            for slot in &mut needed[first..=last] {
+                *slot = true;
+            }
+        }
+    }
+    for (index, &fetch) in needed.iter().enumerate().take(used).skip(1) {
+        if fetch {
+            read_bitmap_part(
+                store,
+                snapshot,
+                entry.key,
+                kind,
+                value.blocks,
+                output,
+                index,
+            )?;
+        }
+    }
+    Ok((value, Bitmap::open(output)?))
+}
+
+fn read_bitmap_part<S: PageStore>(
+    store: &mut S,
+    snapshot: GroupSnapshot,
+    key: [u64; 2],
+    kind: GroupPageKind,
+    blocks: [u32; 3],
+    output: &mut [u8],
+    index: usize,
+) -> Result<()> {
+    let block = *blocks.get(index).ok_or(Error::InvalidState)?;
+    let page = load(store, block, PageKind::Grouped)?;
+    let data = page.group_data()?;
+    let start = index * GROUP_DATA_BYTES;
+    let end = (start + GROUP_DATA_BYTES).min(output.len());
+    let used = output.len().div_ceil(GROUP_DATA_BYTES);
+    if data.id != snapshot.id
+        || data.kind != kind
+        || data.key != key
+        || data.total as usize != output.len()
+        || data.offset as usize != start
+        || data.bytes.len() != end - start
+        || (index + 1 < used && page.next()? != blocks[index + 1])
+    {
+        return Err(Error::InvalidState);
+    }
+    output[start..end].copy_from_slice(data.bytes);
+    Ok(())
+}
